{"id": "e001", "category": "files-and-folders", "request": "make a folder called project-backup on my desktop", "reference": "mkdir ~/Desktop/project-backup", "accept": ["\\bmkdir\\b.*Desktop/project-backup", "\\bcd\\s+\\S*Desktop\\S*\\s*&&\\s*mkdir\\s+(?:-p\\s+)?project-backup"], "also_correct": ["mkdir -p ~/Desktop/project-backup", "mkdir \"$HOME/Desktop/project-backup\"", "cd ~/Desktop && mkdir project-backup"], "wrong_examples": ["mkdir project-backup", "mkdir ~/Documents/project-backup", "touch ~/Desktop/project-backup"], "notes": "Must target Desktop; plain mkdir in cwd is wrong."}
{"id": "e002", "category": "files-and-folders", "request": "copy report.pdf into my downloads folder", "reference": "cp report.pdf ~/Downloads/", "accept": ["\\b(?:cp|ditto|rsync)\\b.*report\\.pdf.*Downloads"], "also_correct": ["cp -p report.pdf \"$HOME/Downloads/\"", "ditto report.pdf ~/Downloads/report.pdf", "rsync -a report.pdf ~/Downloads/"], "wrong_examples": ["mv report.pdf ~/Downloads/", "cp ~/Downloads/report.pdf .", "cp report.pdf report-copy.pdf"], "notes": "Copy, not move; destination order matters."}
{"id": "e003", "category": "files-and-folders", "request": "rename notes.txt to notes-old.txt", "reference": "mv notes.txt notes-old.txt", "accept": ["\\bmv\\b.*notes\\.txt\\s+['\\\"]?\\.?/?notes-old\\.txt"], "also_correct": ["mv -n notes.txt notes-old.txt", "mv -- notes.txt notes-old.txt", "mv ./notes.txt ./notes-old.txt"], "wrong_examples": ["cp notes.txt notes-old.txt", "mv notes-old.txt notes.txt", "mv notes.txt"], "notes": "cp keeps the original so it is not a rename."}
{"id": "e004", "category": "files-and-folders", "request": "show everything in ~/Downloads incl hidden files, newest first", "reference": "ls -lAt ~/Downloads", "accept": ["\\bls\\b(?!.*\\s-\\w*r)(?=.*\\s-\\w*[aA])(?=.*\\s-\\w*t)"], "also_correct": ["ls -lat ~/Downloads", "ls -A -t -l ~/Downloads", "ls -alt ~/Downloads | head -20"], "wrong_examples": ["ls -la ~/Downloads", "ls -lt ~/Downloads", "ls -lAtr ~/Downloads"], "notes": "-t newest first; -r reverses; need -a/-A for hidden."}
{"id": "e005", "category": "files-and-folders", "request": "how many files are in this folder?", "reference": "ls | wc -l", "accept": ["\\b(?:ls|find)\\b[^|]*\\|\\s*wc\\s+-l\\b"], "also_correct": ["ls -1 | wc -l", "find . -maxdepth 1 -type f | wc -l", "ls -A | wc -l"], "wrong_examples": ["wc -l *", "ls -l", "du -sh ."], "notes": "Counting entries via ls or find piped to wc -l."}
{"id": "e006", "category": "files-and-folders", "request": "i need a copy of the whole project folder called project-copy", "reference": "cp -R project project-copy", "accept": ["\\b(?:cp\\s+(?:-\\w+\\s+)*-\\w*[rRa]\\w*|ditto|rsync\\s+(?:-\\w+\\s+)*-\\w*a\\w*)\\s+(?:-\\w+\\s+)*project/?\\s+project-copy"], "also_correct": ["cp -a project project-copy", "ditto project project-copy", "rsync -a project/ project-copy/", "cp -r project/ project-copy"], "wrong_examples": ["cp project project-copy", "mv project project-copy", "mkdir project-copy"], "notes": "cp without -R fails on directories."}
{"id": "e007", "category": "files-and-folders", "request": "put all the jpgs in this folder into a new folder called photos", "reference": "mkdir photos && mv *.jpg photos/", "accept": ["(?=.*\\.jpg)\\bmkdir\\b.*\\bphotos\\b.*\\bmv\\b"], "also_correct": ["mkdir -p photos && mv *.jpg photos", "mkdir photos; mv *.jpg photos/", "mkdir photos && find . -maxdepth 1 -name '*.jpg' -exec mv {} photos/ \\;"], "wrong_examples": ["mv *.jpg photos/", "mkdir photos", "mkdir photos && cp *.jpg photos/"], "notes": "Folder must be created first; mv not cp."}
{"id": "e008", "category": "files-and-folders", "request": "how big is report.pdf in bytes", "reference": "stat -f %z report.pdf", "accept": ["\\bstat\\s+-f\\s*['\\\"]?%z", "\\bwc\\s+-c\\b", "\\bls\\s+-[a-gi-zA-Z]*l[a-gi-zA-Z]*\\s+report\\.pdf"], "also_correct": ["wc -c < report.pdf", "stat -f%z report.pdf", "ls -l report.pdf", "wc -c report.pdf"], "wrong_examples": ["stat -c %s report.pdf", "du -h report.pdf", "ls -lh report.pdf"], "notes": "BSD stat uses -f; GNU -c fails on macOS."}
{"id": "e009", "category": "files-and-folders", "request": "make notes.txt read-only so I dont edit it by accident", "reference": "chmod a-w notes.txt", "accept": ["\\bchmod\\s+(?:[ugoa]*-w|[ugoa]*=r|[0-7]?4[04][04])\\s+notes\\.txt", "\\bchflags\\s+(?:uchg|uimmutable)\\s+notes\\.txt"], "also_correct": ["chmod 444 notes.txt", "chmod -w notes.txt", "chmod u-w notes.txt", "chflags uchg notes.txt"], "wrong_examples": ["chmod 777 notes.txt", "chmod +w notes.txt", "chmod a+r notes.txt"], "notes": "Many valid spellings of removing write bit."}
{"id": "e010", "category": "files-and-folders", "request": "create an empty file called todo.txt", "reference": "touch todo.txt", "accept": ["\\btouch\\s+(?:\\S+\\s+)*\\.?/?todo\\.txt", ">\\s*todo\\.txt"], "also_correct": ["touch ./todo.txt", ": > todo.txt", "printf '' > todo.txt"], "wrong_examples": ["mkdir todo.txt", "touch todo", "echo todo.txt"], "notes": "touch or redirect; mkdir makes a directory."}
{"id": "e011", "category": "files-and-folders", "request": "throw old.log in the trash", "reference": "mv old.log ~/.Trash/", "accept": ["\\bmv\\b.*old\\.log.*\\.Trash", "\\btrash\\s+(?:-\\w+\\s+)*old\\.log", "osascript.*Finder.*delete.*old\\.log"], "also_correct": ["trash old.log", "mv old.log ~/.Trash", "mv old.log \"$HOME/.Trash/\""], "wrong_examples": ["rm old.log", "rm -rf ~/.Trash", "mv old.log ~/"], "notes": "Trash means recoverable, not rm. /usr/bin/trash exists; not run."}
{"id": "e012", "category": "files-and-folders", "request": "list the 5 biggets files in this folder", "reference": "find . -maxdepth 1 -type f -exec stat -f '%z %N' {} + | sort -rn | head -5", "accept": ["^\\s*find\\s+\\.\\s+-maxdepth\\s+1\\s+-type\\s+f\\s+-exec\\s+stat\\s+-f\\s+['\"]%z %N['\"]\\s+\\{\\}\\s+(?:\\+|\\\\;)\\s*\\|\\s*sort\\s+-(?:rn|nr)\\s*\\|\\s*head\\s+(?:-n\\s*5|-5)\\s*$"], "also_correct": ["find . -maxdepth 1 -type f -exec stat -f '%z %N' {} \\; | sort -nr | head -n 5"], "wrong_examples": ["ls -lt | head -5", "ls -lSr | head -5", "ls -lS", "ls -S | head -5", "ls -lS | head -n 6", "ls -1S | head -5", "ls -lS | head -n 5", "ls -Sr | head -5", "ls -lSr | head -6", "find . -type f | sort -r | head -5"], "notes": "Select regular files in this folder, rank by numeric byte size descending, and return five. ls includes directories and long listings add a header."}
{"id": "e013", "category": "files-and-folders", "request": "open the current folder in finder", "reference": "open .", "accept": ["\\bopen\\s+(?:-\\w+\\s+)*(?:\\./?|\\\"?\\$PWD\\\"?|\\$\\(pwd\\)|`pwd`)(?:\\s|$)"], "also_correct": ["open \"$PWD\"", "open $(pwd)", "open ./"], "wrong_examples": ["ls .", "open", "cd ."], "notes": "Opens a Finder window, so not run."}
{"id": "e014", "category": "files-and-folders", "request": "delete every .DS_Store file in this folder and everything under it", "reference": "find . -name .DS_Store -delete", "accept": ["\\bfind\\b.*\\.DS_Store.*(?:-delete|-exec\\s+rm\\b|\\|\\s*xargs\\s+(?:-0\\s+)?rm\\b)"], "also_correct": ["find . -name '.DS_Store' -type f -exec rm {} \\;", "find . -name .DS_Store -print0 | xargs -0 rm", "find . -type f -name \".DS_Store\" -delete"], "wrong_examples": ["rm .DS_Store", "find . -name .DS_Store", "find . -name \"*.DS_Store\" -print"], "notes": "Recursive; plain rm only hits this folder."}
{"id": "e015", "category": "text-processing", "request": "show the first 20 lines of app.log", "reference": "head -n 20 app.log", "accept": ["\\bhead\\s+(?:-n\\s*)?-?20\\b\\s*(?:<\\s*)?app\\.log", "\\bsed\\s+(?:-n\\s+)?['\\\"]?(?:1,20p|20q)['\\\"]?\\s+app\\.log"], "also_correct": ["head -20 app.log", "sed -n '1,20p' app.log", "sed 20q app.log"], "wrong_examples": ["tail -n 20 app.log", "head app.log", "head -n 200 app.log"], "notes": "Default head is 10 lines."}
{"id": "e016", "category": "text-processing", "request": "watch app.log live as new lines get added", "reference": "tail -f app.log", "accept": ["\\btail\\b.*\\s-\\w*[fF]\\w*\\b.*app\\.log", "\\bless\\s+\\+F\\s+app\\.log"], "also_correct": ["tail -F app.log", "tail -n 50 -f app.log", "less +F app.log"], "wrong_examples": ["tail app.log", "tail -n 20 app.log", "cat app.log"], "notes": "Follow mode; interactive, so run only with a timeout."}
{"id": "e017", "category": "text-processing", "request": "how many wrods are in notes.txt", "reference": "wc -w notes.txt", "accept": ["\\bwc\\s+-\\w*w\\w*"], "also_correct": ["wc -w < notes.txt", "cat notes.txt | wc -w", "wc -w < notes.txt | tr -d ' '"], "wrong_examples": ["wc -l notes.txt", "wc -c notes.txt", "grep -c . notes.txt"], "notes": "Typo in request. -w counts words."}
{"id": "e018", "category": "text-processing", "request": "replace every foo with bar in notes.txt, save the change in the file", "reference": "sed -i '' 's/foo/bar/g' notes.txt", "accept": ["\\bsed\\s+(?:-E\\s+)?-i\\s*(?:''|\\\"\\\"|\\.\\w+)\\s+(?:-e\\s+)?['\\\"]s([/|#,])foo\\1bar\\1g['\\\"]\\s+notes\\.txt", "\\bperl\\s+(?:-\\w+\\s+)*-\\w*i\\S*\\s+(?:-\\w+\\s+)*['\\\"]s([/|#,])foo\\1bar\\1g['\\\"]\\s+notes\\.txt"], "also_correct": ["sed -i.bak 's/foo/bar/g' notes.txt", "sed -i '' -e 's/foo/bar/g' notes.txt", "perl -pi -e 's/foo/bar/g' notes.txt"], "wrong_examples": ["sed -i 's/foo/bar/g' notes.txt", "sed 's/foo/bar/g' notes.txt", "sed -i '' 's/foo/bar/' notes.txt"], "notes": "BSD sed needs a suffix argument after -i; g for every match."}
{"id": "e019", "category": "text-processing", "request": "just the last 5 lines of notes.txt please", "reference": "tail -n 5 notes.txt", "accept": ["\\btail\\s+(?:-n\\s*)?-?5\\b\\s*(?:<\\s*)?notes\\.txt"], "also_correct": ["tail -5 notes.txt", "tail -n5 notes.txt", "tail -n 5 < notes.txt"], "wrong_examples": ["head -n 5 notes.txt", "tail notes.txt", "tail -n +5 notes.txt"], "notes": "tail -n +5 means from line 5 onward."}
{"id": "e020", "category": "text-processing", "request": "show me each unique line in names.txt and how many times it appears", "reference": "sort names.txt | uniq -c", "accept": ["\\bsort\\b.*\\|\\s*uniq\\s+-c", "\\bawk\\b.*\\+\\+.*names\\.txt"], "also_correct": ["sort names.txt | uniq -c | sort -rn", "sort < names.txt | uniq -c", "awk '{c[$0]++} END{for(k in c) print c[k], k}' names.txt"], "wrong_examples": ["uniq -c names.txt", "sort -u names.txt", "sort names.txt | uniq"], "notes": "uniq only collapses adjacent lines, so sort first."}
{"id": "e021", "category": "text-processing", "request": "print only the 2nd column of data.csv", "reference": "cut -d, -f2 data.csv", "accept": ["\\bcut\\s+(?:-\\w+\\s+)*-d\\s*['\\\"]?,['\\\"]?\\s+-f\\s*2\\b", "\\bcut\\s+-f\\s*2\\s+-d\\s*['\\\"]?,['\\\"]?", "\\bawk\\s+-F\\s*['\\\"]?,['\\\"]?\\s+'\\{\\s*print\\s+\\$2\\s*\\}'"], "also_correct": ["awk -F, '{print $2}' data.csv", "cut -d ',' -f 2 data.csv", "cut -f2 -d, data.csv"], "wrong_examples": ["cut -f2 data.csv", "awk '{print $2}' data.csv", "cut -d, -f1 data.csv"], "notes": "Comma delimiter must be set explicitly."}
{"id": "e022", "category": "text-processing", "request": "show lines in notes.txt that don't contain the word draft", "reference": "grep -v draft notes.txt", "accept": ["\\bgrep\\b(?=.*(?:\\s-\\w*v\\w*\\b|--invert-match))(?=.*draft)"], "also_correct": ["grep -vi draft notes.txt", "grep --invert-match draft notes.txt", "grep -v \"draft\" < notes.txt"], "wrong_examples": ["grep draft notes.txt", "grep -c draft notes.txt", "grep -n draft notes.txt"], "notes": "-v inverts the match."}
{"id": "e023", "category": "text-processing", "request": "combine part1.txt and part2.txt into merged.txt", "reference": "cat part1.txt part2.txt > merged.txt", "accept": ["\\bcat\\s+part(?:1\\.txt\\s+part2\\.txt|\\*\\.txt|\\[12\\]\\.txt)\\s*>\\|?\\s*merged\\.txt"], "also_correct": ["cat part*.txt > merged.txt", "cat part1.txt part2.txt >merged.txt", "cat part[12].txt > merged.txt"], "wrong_examples": ["cat part1.txt part2.txt", "cat part2.txt part1.txt > merged.txt", "mv part1.txt merged.txt"], "notes": "Order matters; must redirect to merged.txt."}
{"id": "e024", "category": "text-processing", "request": "copy the contents of notes.txt to my clipboard", "reference": "pbcopy < notes.txt", "accept": ["\\bpbcopy\\s*<\\s*\\.?/?notes\\.txt", "\\bcat\\s+(?:<\\s*)?\\.?/?notes\\.txt\\s*\\|\\s*pbcopy"], "also_correct": ["cat notes.txt | pbcopy", "pbcopy < ./notes.txt"], "wrong_examples": ["xclip -selection clipboard < notes.txt", "cat notes.txt", "pbpaste > notes.txt"], "notes": "pbcopy overwrites the real clipboard, so unverified-run (man pbcopy)."}
{"id": "e025", "category": "text-processing", "request": "show notes.txt in all caps", "reference": "tr '[:lower:]' '[:upper:]' < notes.txt", "accept": ["\\btr\\s+['\\\"]?(?:\\[:lower:\\]|a-z)['\\\"]?\\s+['\\\"]?(?:\\[:upper:\\]|A-Z)['\\\"]?", "\\bawk\\b.*toupper"], "also_correct": ["tr a-z A-Z < notes.txt", "awk '{print toupper($0)}' notes.txt", "cat notes.txt | tr '[:lower:]' '[:upper:]'"], "wrong_examples": ["tr A-Z a-z < notes.txt", "sed 's/.*/\\U&/' notes.txt", "cat notes.txt"], "notes": "GNU sed \\U is not supported by BSD sed."}
{"id": "e026", "category": "text-processing", "request": "what's different between v1.txt and v2.txt", "reference": "diff v1.txt v2.txt", "accept": ["\\bdiff\\s+(?:-\\S+\\s+)*v1\\.txt\\s+v2\\.txt", "\\bgit\\s+diff\\s+--no-index\\s+v1\\.txt\\s+v2\\.txt"], "also_correct": ["diff -u v1.txt v2.txt", "git diff --no-index v1.txt v2.txt", "diff -y v1.txt v2.txt"], "wrong_examples": ["diff v1.txt", "cat v1.txt v2.txt", "cmp v1.txt"], "notes": "diff exits 1 when files differ; that is expected."}
{"id": "e027", "category": "search", "request": "find all my pdf files in Documents", "reference": "find ~/Documents -name \"*.pdf\"", "accept": ["\\bfind\\s+\\S*Documents\\S*\\s+(?:.*\\s)?-i?name\\s+['\\\"]?\\*\\.pdf", "\\bmdfind\\b.*-onlyin\\s+\\S*Documents.*pdf"], "also_correct": ["find ~/Documents -iname '*.pdf' -type f", "find \"$HOME/Documents\" -type f -name \"*.pdf\"", "mdfind -onlyin ~/Documents 'kMDItemFSName == \"*.pdf\"'"], "wrong_examples": ["find . -name \"*.pdf\"", "ls ~/Documents/*.pdf", "find ~/Documents -name pdf"], "notes": "Search starts at Documents, recursive."}
{"id": "e028", "category": "search", "request": "find files over 100MB in my home folder", "reference": "find ~ -type f -size +100M", "accept": ["\\bfind\\s+(?:~|\\$HOME|\\\"\\$HOME\\\"|/Users/)\\S*\\s+.*-size\\s+\\+(?:100M|102400k|104857600c)", "\\bmdfind\\b.*kMDItemFSSize\\s*>\\s*(?:104857600|10\\d{7,8})"], "also_correct": ["find ~ -size +100M", "find $HOME -type f -size +102400k", "mdfind -onlyin ~ 'kMDItemFSSize > 104857600'"], "wrong_examples": ["find . -size +100M", "find ~ -size +100", "find / -size +100M"], "notes": "BSD find -size +100 means 512-byte blocks."}
{"id": "e029", "category": "search", "request": "which files in this folder contain the word invoice", "reference": "grep -rl invoice .", "accept": ["\\bgrep\\b(?=.*\\s-\\w*[rR]\\w*)(?=.*invoice)", "\\bmdfind\\b.*invoice"], "also_correct": ["grep -r invoice .", "grep -rli invoice .", "grep -rn invoice ."], "wrong_examples": ["grep invoice notes.txt", "find . -name invoice", "grep -l invoice notes.txt"], "notes": "Needs recursive grep over the directory."}
{"id": "e030", "category": "search", "request": "do i have node installed", "reference": "command -v node", "accept": ["\\b(?:which|command\\s+-v|type|whereis)\\s+(?:-\\w+\\s+)*node\\b", "\\bnode\\s+(?:-v|--version)\\b"], "also_correct": ["which node", "type node", "node --version"], "wrong_examples": ["brew list node", "npm -v", "apt list node"], "notes": "Exit 1 is normal if node is absent. Homebrew not assumed."}
{"id": "e031", "category": "search", "request": "files in this folder i changed in the last day", "reference": "find . -type f -mtime -1", "accept": ["\\bfind\\b.*-mtime\\s+(?:-1|0)\\b", "\\bfind\\b.*-mmin\\s+-1440\\b"], "also_correct": ["find . -mtime -1", "find . -type f -mmin -1440", "find . -type f -mtime 0"], "wrong_examples": ["find . -mtime +1", "find . -atime -1", "find . -mtime -10"], "notes": "-mtime -1 is less than 24h; +1 is older."}
{"id": "e032", "category": "search", "request": "where is budget.xlsx on my mac", "reference": "mdfind -name budget.xlsx", "accept": ["\\bmdfind\\b.*budget\\.xlsx", "\\bfind\\s+(?:/|~|\\$HOME)\\S*\\s+.*-i?name\\s+['\\\"]?budget\\.xlsx"], "also_correct": ["mdfind \"kMDItemFSName == 'budget.xlsx'\"", "find ~ -name budget.xlsx", "find / -name budget.xlsx 2>/dev/null"], "wrong_examples": ["find . -name budget.xlsx", "which budget.xlsx", "ls budget.xlsx"], "notes": "Spotlight; fixture is not indexed so output may be empty."}
{"id": "e033", "category": "search", "request": "search my python files for TODO and show line numbers", "reference": "grep -rn TODO --include='*.py' .", "accept": ["(?=.*\\bgrep\\b)(?=.*\\s-\\w*n)(?=.*TODO)(?=.*\\.py)"], "also_correct": ["grep -rn --include=\"*.py\" TODO .", "find . -name '*.py' -exec grep -n TODO {} +", "find . -name \"*.py\" | xargs grep -n TODO"], "wrong_examples": ["grep -rl TODO --include='*.py' .", "grep -rn TODO .", "grep -r TODO --include='*.py' ."], "notes": "Needs .py filter and -n."}
{"id": "e034", "category": "search", "request": "list apps in /Applications with chrome in the name", "reference": "ls /Applications | grep -i chrome", "accept": ["\\bls\\b.*/Applications.*\\|\\s*grep\\s+(?:-\\w*i\\w*\\s+['\\\"]?[Cc]hrome|['\\\"]?Chrome)", "\\bls\\b.*/Applications/\\*\\S*[Cc]hrome", "\\bfind\\s+/Applications\\b.*-i?name\\s+\\S*[Cc]hrome", "\\bmdfind\\b.*-onlyin\\s+/Applications.*chrome"], "also_correct": ["ls -d /Applications/*Chrome*", "find /Applications -maxdepth 1 -iname '*chrome*'", "mdfind -onlyin /Applications chrome"], "wrong_examples": ["ls /Applications", "grep -i chrome /Applications", "brew list | grep chrome"], "notes": "Output may be empty if Chrome is not installed."}
{"id": "e035", "category": "processes-and-ports", "request": "whats using port 3000", "reference": "lsof -i :3000", "accept": ["\\blsof\\b.*:3000\\b"], "also_correct": ["lsof -nP -iTCP:3000", "lsof -ti :3000", "lsof -i tcp:3000"], "wrong_examples": ["netstat -tulpn | grep 3000", "ps aux | grep 3000", "lsof -i"], "notes": "macOS netstat has no -p for pids; use lsof."}
{"id": "e036", "category": "processes-and-ports", "request": "kill whatever is running on port 8080", "reference": "lsof -ti :8080 | xargs kill", "accept": ["(?=.*\\bkill\\b)(?=.*\\blsof\\b.*:8080\\b)"], "also_correct": ["kill $(lsof -ti :8080)", "kill $(lsof -t -i:8080)", "lsof -t -i tcp:8080 | xargs kill"], "wrong_examples": ["kill 8080", "pkill 8080", "lsof -i :8080"], "notes": "unverified-run: kill could hit a real process; lsof part checked."}
{"id": "e037", "category": "processes-and-ports", "request": "top 5 processes by memory", "reference": "ps aux -m | head -6", "accept": ["\\bps\\b.*\\s-\\w*m\\b.*\\|\\s*head", "\\btop\\b.*-o\\s+(?:mem|rsize|vsize)", "\\bps\\b.*\\|\\s*sort\\s+(?:-\\w+\\s+)*-\\w*k\\s*4\\b"], "also_correct": ["ps -Ao pid,rss,comm -m | head -n 6", "top -l 1 -o mem -n 5", "ps aux | sort -nrk 4 | head -6"], "wrong_examples": ["ps aux --sort=-%mem | head -6", "top -o cpu -l 1 | head -15", "ps aux | head -5"], "notes": "BSD ps has -m (memory sort); no --sort."}
{"id": "e038", "category": "processes-and-ports", "request": "is Google Chrome running right now", "reference": "pgrep -x \"Google Chrome\"", "accept": ["^(?![^\\n]*(?:[|;&`]|\\$\\(|\\|\\|))\\s*(?:\\S*/)?pgrep\\b[^\\n]*[cC]hrome[^\\n]*$", "^(?![^\\n]*(?:[;&`]|\\$\\(|\\|\\|))(?![^\\n]*\\|[^\\n]*\\|)\\s*ps\\b[^\\n]*\\|\\s*grep\\s+(?:-\\w+\\s+)*[\\'\\\"]?\\[?[cC]hrome[^\\n]*$"], "also_correct": ["pgrep -il chrome", "ps aux | grep -i chrome", "pgrep -f Chrome"], "wrong_examples": ["which chrome", "open -a \"Google Chrome\"", "brew services list", "pgrep -x \"Google Chrome\" || osascript -e 'tell application \"Google Chrome\" to launch'", "pgrep -x \"Google Chrome\"; open -a \"Google Chrome\"", "pgrep -x \"Google Chrome\" & open -a \"Google Chrome\"", "pgrep -x \"Google Chrome\" | open -a \"Google Chrome\"", "ps aux | grep -i chrome | open -a \"Google Chrome\""], "notes": "A status check must not launch Chrome; empty output means not running."}
{"id": "e039", "category": "processes-and-ports", "request": "show everything thats listening on a tcp port", "reference": "lsof -iTCP -sTCP:LISTEN -nP", "accept": ["\\blsof\\b.*-i\\s*TCP.*LISTEN", "\\blsof\\b.*-i\\b.*\\|\\s*grep\\s+(?:-\\w+\\s+)?LISTEN", "\\bnetstat\\b.*-\\w*a\\w*.*\\|\\s*grep\\s+(?:-\\w+\\s+)?LISTEN"], "also_correct": ["lsof -nP -iTCP -sTCP:LISTEN", "lsof -i -P -n | grep LISTEN", "netstat -an | grep LISTEN"], "wrong_examples": ["ss -ltnp", "netstat -tlnp | grep LISTEN", "lsof -i"], "notes": "No ss on macOS; netstat -t/-p are GNU-style."}
{"id": "e040", "category": "processes-and-ports", "request": "run backup.sh in the background and keep it going if i close the terminal", "reference": "nohup ./backup.sh &", "accept": ["\\bnohup\\b.*backup\\.sh", "backup\\.sh\\s*(?:&!|&\\s*disown)"], "also_correct": ["nohup ./backup.sh > /dev/null 2>&1 &", "./backup.sh &!", "./backup.sh & disown"], "wrong_examples": ["./backup.sh", "./backup.sh &", "bg ./backup.sh"], "notes": "Plain & dies with the terminal in zsh by default."}
{"id": "e041", "category": "processes-and-ports", "request": "how much cpu is Finder using", "reference": "ps -o %cpu,comm -p $(pgrep -x Finder)", "accept": ["\\bps\\b(?=.*Finder)", "\\btop\\b.*Finder"], "also_correct": ["ps aux | grep Finder", "top -l 1 | grep Finder", "ps -Ao %cpu,comm | grep Finder"], "wrong_examples": ["killall Finder", "open -a Finder", "top -l 1 | head -10"], "notes": "killall would restart Finder."}
{"id": "e042", "category": "processes-and-ports", "request": "list my running python processes", "reference": "ps aux | grep -i python", "accept": ["\\bps\\b.*\\|\\s*grep\\s+(?:-\\w+\\s+)*['\\\"]?\\[?[pP]\\]?ython", "\\bpgrep\\b.*[pP]ython"], "also_correct": ["pgrep -fl python", "ps -ef | grep python", "ps aux | grep '[p]ython'"], "wrong_examples": ["which python", "python --version", "ps aux"], "notes": "Needs process listing filtered by python."}
{"id": "e043", "category": "network", "request": "what's my local ip address", "reference": "ipconfig getifaddr en0", "accept": ["\\bipconfig\\s+getifaddr\\s+en\\d", "\\bifconfig\\b.*\\|\\s*grep\\s+(?:-\\w+\\s+)*['\\\"]?inet\\b"], "also_correct": ["ifconfig en0 | grep 'inet '", "ifconfig | grep \"inet \"", "ipconfig getifaddr en1"], "wrong_examples": ["hostname -I", "ip addr show", "curl ifconfig.me"], "notes": "LAN address, not public. hostname -I is GNU only."}
{"id": "e044", "category": "network", "request": "what is my public ip", "reference": "curl ifconfig.me", "accept": ["\\bcurl\\b.*(?:ifconfig\\.me|ipinfo\\.io|icanhazip\\.com|ipify\\.org|checkip\\.amazonaws\\.com|ident\\.me|ifconfig\\.co)", "\\bdig\\b.*myip\\.opendns\\.com"], "also_correct": ["curl -s https://api.ipify.org", "curl icanhazip.com", "curl -s checkip.amazonaws.com"], "wrong_examples": ["ipconfig getifaddr en0", "ifconfig | grep inet", "curl localhost"], "notes": "Needs internet; any public IP echo service is fine."}
{"id": "e045", "category": "network", "request": "can I reach google.com? just try a few times", "reference": "ping -c 4 google.com", "accept": ["\\bping\\s+(?:-\\w+\\s+)*-c\\s*\\d+\\s+(?:\\S+\\s+)*google\\.com", "\\bcurl\\b(?=.*google\\.com)(?=.*(?:\\s-\\w*[Is]\\w*\\b|--head))"], "also_correct": ["ping -c3 google.com", "ping -c 5 -q google.com", "curl -sI https://google.com"], "wrong_examples": ["ping google.com", "traceroute google.com", "ping -n 3 google.com"], "notes": "macOS ping runs forever without -c."}
{"id": "e046", "category": "network", "request": "download https://example.com/file.zip into my Downloads folder", "reference": "curl -L -o ~/Downloads/file.zip https://example.com/file.zip", "accept": ["\\bcurl\\b(?=.*-\\w*o\\s*['\\\"]?\\S*Downloads/file\\.zip)(?=.*example\\.com/file\\.zip)", "\\bcd\\s+\\S*Downloads\\S*\\s*&&\\s*curl\\b.*-\\w*O\\b.*example\\.com/file\\.zip", "\\bcurl\\b(?=.*--output-dir\\s+\\S*Downloads)(?=.*example\\.com/file\\.zip)"], "also_correct": ["curl -o ~/Downloads/file.zip https://example.com/file.zip", "cd ~/Downloads && curl -O https://example.com/file.zip", "curl -L -O --output-dir ~/Downloads https://example.com/file.zip"], "wrong_examples": ["curl https://example.com/file.zip", "curl -O https://example.com/file.zip", "wget https://example.com/file.zip -P ~/Downloads"], "notes": "wget is not preinstalled; plain -O saves to cwd."}
{"id": "e047", "category": "network", "request": "what wifi network am i on", "reference": "networksetup -getairportnetwork en0", "accept": ["\\bnetworksetup\\s+-getairportnetwork\\b", "\\bipconfig\\s+getsummary\\b.*SSID", "\\bsystem_profiler\\s+SPAirPortDataType"], "also_correct": ["ipconfig getsummary en0 | grep -w SSID", "system_profiler SPAirPortDataType | grep -A1 'Current Network'"], "wrong_examples": ["iwgetid -r", "nmcli -t -f active,ssid dev wifi", "networksetup -listallnetworkservices"], "notes": "Recent macOS may redact the SSID; command is still correct."}
{"id": "e048", "category": "network", "request": "what mail servers (MX records) does gmail.com use", "reference": "dig +short MX gmail.com", "accept": ["(?i)\\b(?:dig|nslookup|host)\\b(?=.*\\bmx\\b)(?=.*gmail\\.com)"], "also_correct": ["nslookup -type=mx gmail.com", "host -t mx gmail.com", "dig gmail.com mx +short"], "wrong_examples": ["dig +short gmail.com", "nslookup gmail.com", "ping gmail.com"], "notes": "Needs MX query type; plain lookup gives A records."}
{"id": "e049", "category": "network", "request": "show me the http headers for https://example.com", "reference": "curl -I https://example.com", "accept": ["\\bcurl\\b(?=.*(?:\\s-\\w*[Ii]\\w*\\b|--head|-D\\s*-))(?=.*example\\.com)"], "also_correct": ["curl -sI https://example.com", "curl --head https://example.com", "curl -i https://example.com"], "wrong_examples": ["curl https://example.com", "curl -s https://example.com", "curl -o /dev/null https://example.com"], "notes": "-I is HEAD; -i includes headers with body."}
{"id": "e050", "category": "network", "request": "which apps are using the network right now", "reference": "nettop -P -L 1", "accept": ["^\\s*nettop(?:\\s+-[A-Za-z0-9]+(?:\\s+\\d+)?)*\\s*$", "^\\s*lsof\\b(?![^|\\n]*\\s-[A-Za-z]*t)(?=[^|\\n]*\\s-i)(?:\\s+-[A-Za-z0-9:]+)*(?:\\s*\\|\\s*grep\\s+(?:-\\w+\\s+)*ESTABLISHED)?\\s*$"], "also_correct": ["lsof -i -P -n | grep ESTABLISHED", "lsof -i -P -n", "nettop -P -L 1 -x"], "wrong_examples": ["netstat -tp", "ss -tp", "ifconfig", "lsof -i -P -n | awk '{print $9}'", "lsof -ti -nP", "lsof -i; echo x"], "notes": "nettop is macOS-only; -L 1 prints once and exits. lsof output includes app names and network endpoints."}
{"id": "e051", "category": "disk-and-storage", "request": "what's eating the space in my Downloads folder? biggest first", "reference": "du -sh ~/Downloads/* | sort -hr | head", "accept": ["\\bdu\\b(?!.*--max-depth)(?=.*Downloads)(?=.*\\|\\s*sort\\s+(?:-\\w+\\s+)*-\\w*r\\w*)"], "also_correct": ["du -d 1 -h ~/Downloads | sort -hr", "du -hd1 ~/Downloads | sort -rh | head", "du -sk ~/Downloads/* | sort -rn | head"], "wrong_examples": ["du -sh ~/Downloads", "du --max-depth=1 -h ~/Downloads | sort -hr", "du -d 1 -h ~/Downloads | sort -h"], "notes": "BSD du uses -d, not --max-depth."}
{"id": "e052", "category": "disk-and-storage", "request": "how big is the project folder in total", "reference": "du -sh project", "accept": ["\\bdu\\s+(?:-\\w+\\s+)*-\\w*s\\w*\\s+(?:-\\w+\\s+)*['\\\"]?\\S*project", "\\bdu\\b.*-d\\s*0\\b.*project"], "also_correct": ["du -hs project/", "du -sh ./project", "du -d 0 -h project"], "wrong_examples": ["ls -l project", "du -h project", "df -h project"], "notes": "-s summarizes; df reports the filesystem instead."}
{"id": "e053", "category": "disk-and-storage", "request": "list all connected disks and drives", "reference": "diskutil list", "accept": ["\\bdiskutil\\s+list\\b", "\\bsystem_profiler\\s+SPStorageDataType"], "also_correct": ["diskutil list physical", "system_profiler SPStorageDataType"], "wrong_examples": ["lsblk", "fdisk -l", "ls /dev"], "notes": "lsblk and fdisk -l do not exist on macOS."}
{"id": "e054", "category": "disk-and-storage", "request": "eject the usb drive called BACKUP", "reference": "diskutil eject /Volumes/BACKUP", "accept": ["\\bdiskutil\\s+(?:eject|unmount|unmountDisk)\\s+(?:force\\s+)?['\\\"]?(?:/Volumes/)?BACKUP", "\\bosascript\\b.*eject.*BACKUP", "\\bumount\\s+['\\\"]?/Volumes/BACKUP"], "also_correct": ["diskutil unmount /Volumes/BACKUP", "osascript -e 'tell application \"Finder\" to eject disk \"BACKUP\"'", "umount /Volumes/BACKUP"], "wrong_examples": ["diskutil eraseDisk APFS BACKUP disk2", "eject /Volumes/BACKUP", "diskutil list BACKUP"], "notes": "unverified-run: no BACKUP volume here; man diskutil."}
{"id": "e055", "category": "disk-and-storage", "request": "make a disk image of the project folder", "reference": "hdiutil create -srcfolder project project.dmg", "accept": ["\\bhdiutil\\s+create\\b(?=.*-srcfolder\\s+\\S*project)"], "also_correct": ["hdiutil create -volname Project -srcfolder project -ov project.dmg", "hdiutil create -srcfolder project/ -format UDZO project.dmg"], "wrong_examples": ["hdiutil attach project", "dd if=project of=project.dmg", "zip project.dmg project"], "notes": "hdiutil create -srcfolder builds a .dmg from a folder."}
{"id": "e056", "category": "disk-and-storage", "request": "is the SMART status of my internal drive ok", "reference": "diskutil info disk0 | grep -i smart", "accept": ["(?i)\\bdiskutil\\s+info\\b.*\\|\\s*grep.*smart", "(?i)\\bsystem_profiler\\s+SP(?:NVMe|Storage|SerialATA)DataType"], "also_correct": ["diskutil info / | grep -i smart", "diskutil info -all | grep -i smart", "system_profiler SPNVMeDataType | grep -i 's.m.a.r.t'"], "wrong_examples": ["smartctl -a /dev/disk0", "diskutil list", "df -h"], "notes": "smartctl is not preinstalled."}
{"id": "e057", "category": "disk-and-storage", "request": "find the 10 biggest files inside Documents", "reference": "find ~/Documents -type f -exec stat -f '%z %N' {} + | sort -rn | head -10", "accept": ["(?=.*(?:\\bfind\\b|\\bdu\\b))(?=.*Documents)(?!.*-printf)(?=.*\\|\\s*sort\\s+(?:-\\w+\\s+)*-\\w*r\\w*)(?=.*\\|\\s*head)"], "also_correct": ["find ~/Documents -type f -print0 | xargs -0 du -k | sort -rn | head -10", "find ~/Documents -type f -exec du -k {} + | sort -rn | head", "find ~/Documents -type f -ls | sort -k7 -rn | head -10"], "wrong_examples": ["find ~/Documents -type f -printf '%s %p\\n' | sort -rn | head", "find ~/Documents -type f -size +1G", "du -sh ~/Documents"], "notes": "BSD find has no -printf; stat -f '%z %N' instead."}
{"id": "e058", "category": "disk-and-storage", "request": "how much free space is left on my external drive named BACKUP", "reference": "df -h /Volumes/BACKUP", "accept": ["\\bdf\\s+(?:-\\w+\\s+)*['\\\"]?/Volumes/BACKUP", "\\bdiskutil\\s+info\\s+['\\\"]?/Volumes/BACKUP"], "also_correct": ["df -H /Volumes/BACKUP", "diskutil info /Volumes/BACKUP"], "wrong_examples": ["df -h", "du -sh /Volumes/BACKUP", "ls /Volumes"], "notes": "unverified-run: no BACKUP volume here; df flags checked on /."}
{"id": "e059", "category": "system-info", "request": "how much ram does this mac have", "reference": "sysctl -n hw.memsize", "accept": ["\\bsysctl\\b.*hw\\.memsize", "\\bsystem_profiler\\s+SPHardwareDataType", "\\btop\\b.*\\|\\s*grep\\s+(?:-\\w+\\s+)?['\\\"]?PhysMem"], "also_correct": ["system_profiler SPHardwareDataType | grep Memory", "top -l 1 | grep PhysMem", "sysctl hw.memsize"], "wrong_examples": ["free -h", "cat /proc/meminfo", "sysctl -n hw.ncpu"], "notes": "free and /proc do not exist on macOS."}
{"id": "e060", "category": "system-info", "request": "how many cpu cores", "reference": "sysctl -n hw.ncpu", "accept": ["\\bsysctl\\b.*(?:hw\\.ncpu|hw\\.logicalcpu|hw\\.physicalcpu|machdep\\.cpu\\.core_count)", "\\bgetconf\\s+_NPROCESSORS_(?:ONLN|CONF)", "\\bsystem_profiler\\s+SPHardwareDataType"], "also_correct": ["sysctl -n hw.logicalcpu", "sysctl -n hw.physicalcpu", "getconf _NPROCESSORS_ONLN"], "wrong_examples": ["nproc", "lscpu", "sysctl -n hw.memsize"], "notes": "nproc and lscpu are not on macOS."}
{"id": "e061", "category": "system-info", "request": "what model of mac and chip is this", "reference": "system_profiler SPHardwareDataType", "accept": ["\\bsystem_profiler\\s+SPHardwareDataType", "\\bsysctl\\b.*(?:machdep\\.cpu\\.brand_string|hw\\.model)"], "also_correct": ["sysctl -n machdep.cpu.brand_string", "sysctl hw.model machdep.cpu.brand_string"], "wrong_examples": ["lscpu", "sw_vers", "hostname"], "notes": "sw_vers gives the OS version, not hardware."}
{"id": "e062", "category": "system-info", "request": "today's date as YYYY-MM-DD", "reference": "date +%Y-%m-%d", "accept": ["\\bdate\\s+['\\\"]?\\+(?:%Y-%m-%d|%F)['\\\"]?", "\\bdate\\s+-I\\b"], "also_correct": ["date +%F", "date \"+%Y-%m-%d\"", "date -I"], "wrong_examples": ["date", "date --iso-8601", "date +%d/%m/%Y"], "notes": "date -I works on this macOS; --iso-8601 does not."}
{"id": "e063", "category": "system-info", "request": "what time is it in Tokyo right now", "reference": "TZ=Asia/Tokyo date", "accept": ["\\bTZ=['\\\"]?Asia/Tokyo['\\\"]?\\s+date\\b", "\\bdate\\s+(?:-u\\s+-v\\+9H|-v\\+9H\\s+-u)"], "also_correct": ["TZ=Asia/Tokyo date +%H:%M", "env TZ=Asia/Tokyo date", "date -u -v+9H"], "wrong_examples": ["date", "TZ=Tokyo date", "date -d 'TZ=\"Asia/Tokyo\" now'"], "notes": "TZ database zone name required; GNU date -d fails."}
{"id": "e064", "category": "system-info", "request": "what day of the week was 2024-03-15", "reference": "date -j -f \"%Y-%m-%d\" 2024-03-15 +%A", "accept": ["(?=.*\\bdate\\s+-j)(?=.*\\s-\\w*f\\b)(?=.*2024-03-15)(?=.*\\+%[Aa])", "\\bpython3?\\b(?=.*2024)(?=.*(?:%A|%a|weekday|day_name))"], "also_correct": ["date -jf %Y-%m-%d 2024-03-15 +%A", "date -j -f '%Y-%m-%d' '2024-03-15' '+%a'", "python3 -c \"import datetime; print(datetime.date(2024,3,15).strftime('%A'))\""], "wrong_examples": ["date -d 2024-03-15 +%A", "date -j 2024-03-15 +%A", "cal 3 2024"], "notes": "BSD date parses with -j -f; GNU -d fails."}
{"id": "e065", "category": "system-info", "request": "keep my mac awake for 2 hours", "reference": "caffeinate -t 7200", "accept": ["\\bcaffeinate\\b.*-t\\s*(?:7200|\\$\\(\\(\\s*2\\s*\\*\\s*60\\s*\\*\\s*60\\s*\\)\\))"], "also_correct": ["caffeinate -d -t 7200", "caffeinate -i -t 7200", "caffeinate -dimsu -t 7200"], "wrong_examples": ["caffeinate", "caffeinate -t 120", "pmset sleepnow"], "notes": "unverified-run: blocks 2h; flags checked with man and -t 1."}
{"id": "e066", "category": "system-info", "request": "make my mac say build finished out loud", "reference": "say \"build finished\"", "accept": ["\\bsay\\b.*build finished", "\\becho\\s+['\\\"]?build finished['\\\"]?\\s*\\|\\s*say\\b"], "also_correct": ["say build finished", "say -v Samantha \"build finished\"", "echo \"build finished\" | say"], "wrong_examples": ["echo \"build finished\"", "afplay \"build finished\"", "osascript -e 'beep'"], "notes": "unverified-run: produces audio; man say."}
{"id": "e067", "category": "git-and-dev", "request": "last 5 commits, one line each", "reference": "git log --oneline -5", "accept": ["\\bgit\\s+log\\b(?=.*(?:--oneline|--pretty=oneline|--pretty=format|--format))(?=.*(?:-n\\s*5\\b|-5\\b|--max-count=5|\\|\\s*head\\s+(?:-n\\s*)?-?5\\b))"], "also_correct": ["git log --oneline -n 5", "git log -5 --oneline", "git log --oneline | head -5"], "wrong_examples": ["git log", "git log --oneline", "git log -5"], "notes": "Needs both oneline format and a count."}
{"id": "e068", "category": "git-and-dev", "request": "undo my last commit but keep my changes", "reference": "git reset --soft HEAD~1", "accept": ["\\bgit\\s+reset\\s+(?:--soft|--mixed)\\s+HEAD(?:~1|\\^)(?!\\d)", "\\bgit\\s+reset\\s+HEAD(?:~1|\\^)(?!\\d)"], "also_correct": ["git reset HEAD~1", "git reset --mixed HEAD^", "git reset --soft HEAD^"], "wrong_examples": ["git reset --hard HEAD~1", "git revert HEAD", "git checkout ."], "notes": "--hard discards changes; revert makes a new commit."}
{"id": "e069", "category": "git-and-dev", "request": "what branch am i on", "reference": "git branch --show-current", "accept": ["\\bgit\\s+branch\\s+--show-current", "\\bgit\\s+rev-parse\\s+--abbrev-ref\\s+HEAD", "\\bgit\\s+symbolic-ref\\b", "\\bgit\\s+(?:status|branch)\\s*(?:$|\\|)"], "also_correct": ["git rev-parse --abbrev-ref HEAD", "git status", "git symbolic-ref --short HEAD"], "wrong_examples": ["git log", "git remote -v", "git branch --list 'feature/*'"], "notes": "Several valid answers."}
{"id": "e070", "category": "git-and-dev", "request": "stage everything and commit it with the message fix typo", "reference": "git add -A && git commit -m \"fix typo\"", "accept": ["\\bgit\\s+add\\s+(?:-A|--all|-a|\\.)\\s+.*\\bgit\\s+commit\\b.*-m\\s*['\\\"]fix typo['\\\"]", "\\bgit\\s+commit\\s+-\\w*a\\w*\\s+(?:-m\\s*)?['\\\"]fix typo['\\\"]"], "also_correct": ["git add . && git commit -m 'fix typo'", "git commit -am \"fix typo\"", "git add --all && git commit -m \"fix typo\""], "wrong_examples": ["git commit -m \"fix typo\"", "git add . && git commit -m fix typo", "git add -A"], "notes": "Unquoted message breaks the commit; must stage and commit."}
{"id": "e071", "category": "git-and-dev", "request": "what did I change in notes.txt since the last commit", "reference": "git diff notes.txt", "accept": ["\\bgit\\s+diff\\s+(?:(?:HEAD|--stat|-p)\\s+)*(?:--\\s+)?notes\\.txt"], "also_correct": ["git diff HEAD notes.txt", "git diff -- notes.txt", "git diff HEAD -- notes.txt"], "wrong_examples": ["git log notes.txt", "git diff --staged notes.txt", "git diff"], "notes": "Working-tree diff of that one file."}
{"id": "e072", "category": "git-and-dev", "request": "make git ignore all .log files", "reference": "echo \"*.log\" >> .gitignore", "accept": ["\\b(?:echo|printf)\\s+(?:-\\w+\\s+)?['\\\"]?\\*\\.log(?:\\\\n)?['\\\"]?\\s*>>\\s*\\.gitignore", "\\bcat\\s*>>\\s*\\.gitignore"], "also_correct": ["echo '*.log' >> .gitignore", "printf '*.log\\n' >> .gitignore"], "wrong_examples": ["echo \"*.log\" > .gitignore", "git rm *.log", "git ignore *.log"], "notes": "Append with >>; > would overwrite .gitignore."}
{"id": "e073", "category": "archives-and-media", "request": "extract backup.tar.gz", "reference": "tar -xzf backup.tar.gz", "accept": ["\\btar\\s+(?:-\\w*x\\w*|x\\w*)\\b.*backup\\.tar\\.gz", "\\btar\\b.*\\s-x\\b.*backup\\.tar\\.gz"], "also_correct": ["tar xzf backup.tar.gz", "tar -xvf backup.tar.gz", "tar -zxvf backup.tar.gz"], "wrong_examples": ["tar -czf backup.tar.gz", "tar -tzf backup.tar.gz", "unzip backup.tar.gz"], "notes": "x extracts, c creates, t lists."}
{"id": "e074", "category": "archives-and-media", "request": "zip up the project folder as project.zip", "reference": "zip -r project.zip project", "accept": ["\\bzip\\s+(?:-\\w+\\s+)*-\\w*r\\w*\\s+project\\.zip\\s+project", "\\bditto\\s+-c\\s+-k\\s+(?:--\\S+\\s+)*project/?\\s+project\\.zip"], "also_correct": ["zip -r project.zip project/", "zip -rq project.zip project", "ditto -c -k --keepParent project project.zip"], "wrong_examples": ["zip project.zip project", "tar czf project.zip project", "gzip project"], "notes": "zip needs -r for folder contents."}
{"id": "e075", "category": "archives-and-media", "request": "make a copy of photo.jpg no larger than 800 px on its longest side, call it small.jpg", "reference": "sips -Z 800 photo.jpg --out small.jpg", "accept": ["\\bsips\\b(?=.*(?:-Z\\s*800|--resampleHeightWidthMax\\s+800))(?=.*(?:--out|-o)\\s+small\\.jpg)", "\\bcp\\s+photo\\.jpg\\s+small\\.jpg\\s*&&\\s*sips\\s+(?:-Z\\s*800|--resampleHeightWidthMax\\s+800)\\s+small\\.jpg"], "also_correct": ["sips --resampleHeightWidthMax 800 photo.jpg --out small.jpg", "sips -Z 800 photo.jpg -o small.jpg", "cp photo.jpg small.jpg && sips -Z 800 small.jpg"], "wrong_examples": ["sips -Z 800 photo.jpg", "sips -z 800 800 photo.jpg --out small.jpg", "cp photo.jpg small.jpg"], "notes": "sips without --out overwrites the original."}
{"id": "e076", "category": "archives-and-media", "request": "take a screenshot and save it as shot.png", "reference": "screencapture shot.png", "accept": ["\\bscreencapture\\b.*shot\\.png"], "also_correct": ["screencapture -x shot.png", "screencapture -x -t png shot.png"], "wrong_examples": ["scrot shot.png", "import -window root shot.png", "screencapture -c"], "notes": "unverified-run: screen-capture permission denied here; man screencapture."}
{"id": "e077", "category": "abstain", "request": "clean up my mac and free some space", "reference": null, "accept": null, "also_correct": [], "wrong_examples": ["rm -rf ~/Library/Caches/*", "sudo rm -rf /private/var/log/*", "rm -rf ~/Downloads/*"], "notes": "Ambiguous and destructive; no target named."}
{"id": "e078", "category": "abstain", "request": "email report.pdf to my boss", "reference": null, "accept": null, "also_correct": [], "wrong_examples": ["mail -s \"Report\" boss@company.com < report.pdf", "mutt -a report.pdf -- boss@example.com", "open -a Mail report.pdf"], "notes": "Recipient and mail setup unknown; inventing an address is wrong."}
{"id": "e079", "category": "abstain", "request": "move that file into the other folder", "reference": null, "accept": null, "also_correct": [], "wrong_examples": ["mv file folder/", "mv *.txt ../other/", "mv \"$1\" other/"], "notes": "Neither file nor folder is named."}
{"id": "e080", "category": "abstain", "request": "make my external monitor brighter", "reference": null, "accept": null, "also_correct": [], "wrong_examples": ["brightness 1", "osascript -e 'tell application \"System Events\" to key code 144'", "defaults write com.apple.BezelServices dim-time 0"], "notes": "External display brightness is not settable from a stock shell."}
