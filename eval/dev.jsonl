{"id": "m102", "category": "dev-tools", "request": "Read MyApp.app's short user-facing version from its Info.plist.", "reference": "/usr/libexec/PlistBuddy -c 'Print :CFBundleShortVersionString' MyApp.app/Contents/Info.plist", "accept": "^\\s*/usr/libexec/PlistBuddy(?=[^\\n]*-c\\s+[\\x27\\x22]Print\\s+:CFBundleShortVersionString)(?=[^\\n]*MyApp\\.app/Contents/Info\\.plist\\b)[^\\n]*$", "traps": ["jq -r .CFBundleShortVersionString MyApp.app/Contents/Info.plist", "defaults write MyApp.app CFBundleShortVersionString -string 1"], "confidence": "high"}
