{"id": "m081", "category": "media", "request": "Get the indexed duration in seconds for clip.mov.", "reference": "mdls -name kMDItemDurationSeconds clip.mov", "accept": ["^\\s*(?:/usr/bin/|/bin/|/usr/sbin/|/sbin/)?mdls\\b(?=[^\\n]*-name\\s+kMDItemDurationSeconds\\b)(?=[^\\n]*clip\\.mov\\b)[^\\n]*$", "^\\s*(?:/usr/bin/)?mdls\\s+clip\\.mov\\s*\\|\\s*grep\\s+-F\\s+(?:\\x27kMDItemDurationSeconds\\x27|\"kMDItemDurationSeconds\")\\s*$"], "traps": ["ffprobe clip.mov", "mdls -name kMDItemPixelWidth clip.mov"], "confidence": "high"}
{"id": "m083", "category": "archives", "request": "Show the contents of bundle.zip and their uncompressed sizes.", "reference": "unzip -l bundle.zip", "accept": ["^\\s*(?:/usr/bin/|/bin/|/usr/sbin/|/sbin/)?unzip\\b(?=[^\\n]*-l\\b)(?=[^\\n]*bundle\\.zip\\b)[^\\n]*$", "^\\s*(?:/usr/bin/)?tar\\s+-tvf\\s+bundle\\.zip\\s*$"], "traps": ["unzip bundle.zip", "tar -tf bundle.zip"], "confidence": "high"}
{"id": "m085", "category": "archives", "request": "Extract bundle.zip into extracted/ using ditto and retaining Apple metadata.", "reference": "ditto -x -k bundle.zip extracted/", "accept": ["^\\s*(?:/usr/bin/|/bin/|/usr/sbin/|/sbin/)?ditto\\b(?=[^\\n]*-x\\b)(?=[^\\n]*-k\\b)(?=[^\\n]*bundle\\.zip\\s+extracted/)[^\\n]*$"], "traps": ["unzip bundle.zip -d extracted", "ditto -c -k bundle.zip extracted/"], "confidence": "high"}
{"id": "m087", "category": "archives", "request": "Write a gzip-compressed copy of notes.txt, leaving notes.txt alone.", "reference": "gzip -c notes.txt > notes.txt.gz", "accept": ["^\\s*(?:/usr/bin/|/bin/|/usr/sbin/|/sbin/)?gzip\\b(?=[^\\n]*-c\\b)(?=[^\\n]*notes\\.txt\\s*>\\s*notes\\.txt\\.gz\\b)[^\\n]*$", "^\\s*(?:/usr/bin/)?gzip\\s+-k\\s+notes\\.txt\\s*$", "^\\s*(?:/usr/bin/)?gzip\\s+(?:-c\\s+)?<\\s*notes\\.txt\\s*>\\s*notes\\.txt\\.gz\\s*$"], "traps": ["gzip notes.txt", "zip notes.txt.gz notes.txt"], "confidence": "high"}
{"id": "m089", "category": "archives", "request": "Test notes.txt.gz for gzip corruption; do not unpack it.", "reference": "gzip -t notes.txt.gz", "accept": ["^\\s*(?:/usr/bin/|/bin/|/usr/sbin/|/sbin/)?gzip\\b(?=[^\\n]*-t\\b)(?=[^\\n]*notes\\.txt\\.gz\\b)[^\\n]*$", "^\\s*(?:/usr/bin/)?gunzip\\s+-t\\s+notes\\.txt\\.gz\\s*$", "^\\s*(?:/usr/bin/)?gzip\\s+-(?:tv|vt)\\s+notes\\.txt\\.gz\\s*$"], "traps": ["gunzip notes.txt.gz", "tar -tf notes.txt.gz"], "confidence": "high"}
{"id": "m091", "category": "defaults-and-prefs", "request": "Report whether global macOS appearance is Dark, otherwise say Light.", "reference": "defaults read -g AppleInterfaceStyle 2>/dev/null || echo Light", "accept": ["^\\s*(?:/usr/bin/|/bin/|/usr/sbin/|/sbin/)?defaults\\b(?=[^\\n]*\\bread\\s+-g\\s+AppleInterfaceStyle\\b)(?=[^\\n]*\\becho\\s+Light\\b)(?![^\\n]*\\bwrite\\b)[^\\n]*$", "^\\s*(?:/usr/bin/)?defaults\\s+read\\s+NSGlobalDomain\\s+AppleInterfaceStyle\\s+2>/dev/null\\s*\\|\\|\\s+echo\\s+Light\\s*$", "^\\s*(?:/usr/bin/)?defaults\\s+read\\s+-g\\s+AppleInterfaceStyle\\s+2>/dev/null\\s*\\|\\|\\s+printf\\s+\\x27Light\\\\n\\x27\\s*$"], "traps": ["gsettings get org.gnome.desktop.interface color-scheme", "defaults write -g AppleInterfaceStyle Dark"], "confidence": "high"}
{"id": "m093", "category": "defaults-and-prefs", "request": "What Dock tile size is recorded in preferences?", "reference": "defaults read com.apple.dock tilesize", "accept": ["^\\s*(?:/usr/bin/|/bin/|/usr/sbin/|/sbin/)?defaults\\b(?=[^\\n]*\\bread\\s+com\\.apple\\.dock\\s+tilesize\\b)(?![^\\n]*\\bwrite\\b)[^\\n]*$", "^\\s*(?:/usr/bin/)?defaults\\s+read\\s+com\\.apple\\.dock\\s*\\|\\s*grep\\s+-F\\s+(?:\\x27tilesize\\x27|\"tilesize\")\\s*$"], "traps": ["gsettings get org.gnome.shell dash-max-icon-size", "defaults write com.apple.dock tilesize -int 100"], "confidence": "high"}
{"id": "m095", "category": "defaults-and-prefs", "request": "Check whether MyApp.app/Contents/Info.plist is syntactically valid.", "reference": "plutil -lint MyApp.app/Contents/Info.plist", "accept": ["^\\s*(?:/usr/bin/|/bin/|/usr/sbin/|/sbin/)?plutil\\b(?=[^\\n]*-lint\\b)(?=[^\\n]*MyApp\\.app/Contents/Info\\.plist\\b)[^\\n]*$"], "traps": ["jq . MyApp.app/Contents/Info.plist", "plutil -convert xml1 MyApp.app/Contents/Info.plist"], "confidence": "high"}
{"id": "m097", "category": "defaults-and-prefs", "request": "Find which preference domains contain ApplePressAndHoldEnabled.", "reference": "defaults find ApplePressAndHoldEnabled", "accept": ["^\\s*(?:/usr/bin/|/bin/|/usr/sbin/|/sbin/)?defaults\\b(?=[^\\n]*\\bfind\\s+ApplePressAndHoldEnabled\\b)(?![^\\n]*\\bwrite\\b)[^\\n]*$", "^\\s*(?:/usr/bin/)?defaults\\s+find\\s+(?:\\x27ApplePressAndHoldEnabled\\x27|\"ApplePressAndHoldEnabled\")\\s*$"], "traps": ["grep -R ApplePressAndHoldEnabled /etc", "defaults write -g ApplePressAndHoldEnabled -bool false"], "confidence": "high"}
{"id": "m099", "category": "dev-tools", "request": "Identify the executable file type of MyApp.app/Contents/MacOS/MyApp.", "reference": "file -b MyApp.app/Contents/MacOS/MyApp", "accept": ["^\\s*(?:/usr/bin/|/bin/|/usr/sbin/|/sbin/)?file\\b(?=[^\\n]*-b\\b)(?=[^\\n]*MyApp\\.app/Contents/MacOS/MyApp\\b)[^\\n]*$", "^\\s*(?:/usr/bin/)?file\\s+MyApp\\.app/Contents/MacOS/MyApp\\s*$"], "traps": ["readelf -h MyApp.app/Contents/MacOS/MyApp", "uname -m"], "confidence": "high"}
{"id": "m101", "category": "dev-tools", "request": "Print the code-signing entitlements embedded in MyApp.app.", "reference": "codesign -d --entitlements :- MyApp.app", "accept": ["^\\s*(?:/usr/bin/|/bin/|/usr/sbin/|/sbin/)?codesign\\b(?=[^\\n]*-d\\b)(?=[^\\n]*--entitlements\\s+:-)(?=[^\\n]*MyApp\\.app\\b)(?![^\\n]*--sign\\b)[^\\n]*$", "^\\s*(?:/usr/bin/)?codesign\\s+(?:-d|--display)\\s+--entitlements\\s+-\\s+(?:--xml\\s+)?MyApp\\.app\\s*$"], "traps": ["codesign --sign - MyApp.app", "getcap MyApp.app"], "confidence": "high"}
{"id": "m103", "category": "dev-tools", "request": "List the installer package receipts recorded on this Mac.", "reference": "pkgutil --pkgs", "accept": ["^\\s*(?:/usr/bin/|/bin/|/usr/sbin/|/sbin/)?pkgutil\\b(?=[^\\n]*--pkgs\\b)[^\\n]*$", "^\\s*(?:/usr/sbin/)?pkgutil\\s+--packages\\s*$"], "traps": ["dpkg -l", "brew list"], "confidence": "high"}
{"id": "m105", "category": "dev-tools", "request": "Syntax-check script.zsh without running the script.", "reference": "zsh -n script.zsh", "accept": ["^\\s*(?:/usr/bin/|/bin/|/usr/sbin/|/sbin/)?zsh\\b(?=[^\\n]*-n\\b)(?=[^\\n]*script\\.zsh\\b)[^\\n]*$"], "traps": ["zsh script.zsh", "bash script.zsh"], "confidence": "high"}
